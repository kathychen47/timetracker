{
  "manifest_version": 3,
  "name": "划词查词 · Timetracker",
  "version": "1.0.0",
  "description": "在任意网页选中单词即就地显示牛津/柯林斯释义，选中句子自动翻译，生词存入 Timetracker 生词本。",
  "permissions": ["storage", "unlimitedStorage", "contextMenus"],
  "host_permissions": [
    "https://translate.googleapis.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "action": { "default_title": "划词查词 · 设置" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://kathychen47.github.io/timetracker/*"],
      "js": ["sync.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    { "resources": ["oald.css"], "matches": ["http://*/*", "https://*/*", "file:///*"] }
  ]
}
