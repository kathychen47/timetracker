{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.8.0",
  "description": "__MSG_extDesc__",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://kathychen47.github.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "__MSG_actionTitle__"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "i18n.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "https://kathychen47.github.io/timetracker/*"
      ],
      "js": [
        "sync.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "oald.css"
      ],
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ]
    }
  ],
  "default_locale": "zh_CN"
}
